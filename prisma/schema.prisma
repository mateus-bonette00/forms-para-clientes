// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model ClientSubmission {
  id              String         @id @default(uuid())
  clientName      String
  companyName     String?
  email           String?
  whatsapp        String?
  instagram       String?
  address         String?
  businessHours   String?
  
  aboutMe         String?        @db.Text
  history         String?        @db.Text
  mission         String?        @db.Text
  vision          String?        @db.Text
  values          String?        @db.Text
  slogan          String?
  differentials   String?        @db.Text
  targetAudience  String?        @db.Text
  
  colorPalette    String?
  referenceLinks  String?        @db.Text
  servicesList    String?        @db.Text
  testimonials    String?        @db.Text
  additionalNotes String?        @db.Text
  
  status          String         @default("NOVO") // NOVO, EM_ANALISE, EM_ANDAMENTO, CONCLUIDO
  
  files           UploadedFile[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

model UploadedFile {
  id           String           @id @default(uuid())
  submissionId String
  submission   ClientSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  fileCategory String           // LOGO, EQUIPE, PRODUTO, SERVICO, ESPACO, OUTRO
  fileName     String
  fileUrl      String           @db.Text
  fileSize     Int?
  mimeType     String?
  caption      String?
  
  createdAt    DateTime         @default(now())

  @@index([submissionId])
}

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

